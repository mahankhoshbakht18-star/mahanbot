# ==========================================
# MAHANBOT Configuration Example (.env.example)
# Copy this file to .env and adjust values as needed.
# ==========================================

# 1. Server & Network Binding
MAHANBOT_HOST=127.0.0.1
MAHANBOT_PORT=8000
MAHANBOT_LOG_LEVEL=INFO

# 2. Security & Administrative Access
# Set a strong password before starting server for the first time
MAHANBOT_ADMIN_USER=admin
MAHANBOT_ADMIN_PASSWORD=change_this_password_123!
MAHANBOT_SECRET_KEY=generate_random_secret_string_here

# 3. Database
MAHANBOT_DB=cbi_ultimate.db

# 4. Concurrency & Queue Configuration
# Number of browser instances executing concurrently (Recommended: 2 to 4)
MAHANBOT_MAX_CONCURRENCY=2

# 5. Dedicated OTP Server (Optional - if running separate relay)
MAHAN_OTP_HOST=127.0.0.1
MAHAN_OTP_PORT=8010
MAHAN_OTP_DB=otp_codes.db
MAHAN_OTP_TTL=180
# Secret token shared with Android SMS forwarder app
MAHAN_OTP_SECRET=

# 6. Browser UI Placement & Visual Tuning
# Zoom level inside Chromium: 100%, 125%, 150%, 175%
MAHANBOT_BROWSER_ZOOM=125
MAHANBOT_BROWSER_WIDTH=540
MAHANBOT_BROWSER_HEIGHT=680
