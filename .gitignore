# ==========================================
# MAHANBOT .gitignore — Comprehensive Protection
# ==========================================

# 1. Python System & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.history/

# 2. Database Files (Never commit real applicant data or runtime DBs)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
cbi_ultimate*.db
otp_codes.db
bot.db

# 3. Environment & Secrets
.env
.env.*
!.env.example
.relay.private.env
.licenses.private.env
venv/
.venv/
env/
ENV/

# 4. User Privacy & Session Captures
static/live_browser/*.jpg
static/live_browser/*.jpeg
static/live_browser/*.png
!static/live_browser/.gitkeep
static/test_*.png
static/preview_*.png
saved_pages/
screenshots/
chrome_profiles/
diagnostics/
backups/
logs/
*.log
مشاهده_وضعیت/

# 5. Build Artifacts & Packaging
dist/
build/
*.spec
mahanscripts.zip
mahan/
Debug Script.py
downloads/*.zip
updates_staging/

# 6. IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 7. Media & Videos
*.mp4
*.mkv
*.avi
*.mov

# 8. Temporary Diagnostic Scripts & Database Backups
*.db.backup*
scratch/
dump_*.py
inspect_*.py
query_*.py
extract_*.py
search_*.py
check_applicant.py
list_nids.py
analyze_scripts.py
