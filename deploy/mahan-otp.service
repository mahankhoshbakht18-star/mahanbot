[Unit]
Description=Mahan OTP Relay Service & Update Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/mahanbot
Environment="PYTHONUNBUFFERED=1"
Environment="MAHAN_DOWNLOADS_DIR=/var/www/mahanbot/downloads"
ExecStart=/var/www/mahanbot/.venv/bin/uvicorn otp_server:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
