# Copy to .env.sms-bridge or run setup_sms_bridge_windows.cmd
# Keep this file local and never commit the real device key.

MAHANBOT_SMS_DEVICE_KEY=replace-with-a-random-device-key
MAHANBOT_HOST=0.0.0.0
MAHANBOT_PORT=8000
MAHANBOT_BROWSER_CHANNEL=msedge
MAHANBOT_DEV_MODE=true

